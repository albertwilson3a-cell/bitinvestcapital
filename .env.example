# ═════════════════════════════════════════════════════════════════════
#  BitInvest Capital: docker compose variables
#
#  Copy to .env next to docker-compose.yml. Used to start the local
#  infrastructure (PostgreSQL + Redis cluster) and, with
#  `docker compose --profile app up`, the API container.
#  The API's full variable reference is backend/.env.example; the web
#  app's is frontend/.env.example.
# ═════════════════════════════════════════════════════════════════════

# ── Infrastructure ───────────────────────────────────────────────────
POSTGRES_USER=bitinvest
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=bitinvest
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me-local-only

# ── API container (profile "app") ────────────────────────────────────
BACKEND_PORT=3000
APP_NAME=BitInvest Capital
# 32+ random characters
JWT_SECRET=
JWT_ISSUER=https://bitinvestcapital.com
JWT_AUDIENCE=https://bitinvestcapital.com
CORS_ROOT_DOMAIN=bitinvestcapital.com
CORS_EXTRA_ORIGINS=
FRONTEND_URL=https://bitinvestcapital.com
MAIL_PROVIDER=sendgrid
MAIL_FROM_ADDRESS=no-reply@bitinvestcapital.com
MAIL_FROM_NAME=BitInvest Capital
MAIL_SUPPORT_ADDRESS=support@bitinvestcapital.com
MAIL_WEBSITE_URL=https://bitinvestcapital.com
MAIL_POSTAL_ADDRESS=
SENDGRID_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
ETH_ACCOUNT_XPUB=
BTC_ACCOUNT_XPUB=
BTC_NETWORK=mainnet
USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7
WEBHOOK_SIGNING_SECRETS=
MIN_CONFIRMATIONS_BTC=3
MIN_CONFIRMATIONS_ETH=12
MIN_CONFIRMATIONS_USDT=12
REFERRAL_REWARD_RATE=0.01
AFFILIATE_YIELD_REWARD_RATE=0.05
PRICE_API_KEY=
YIELD_SCHEDULER_ENABLED=true
YIELD_BATCH_SIZE=500
YIELD_MAX_APY_PERCENT=100
