# ═════════════════════════════════════════════════════════════════════
#  BitInvest Capital web app: environment configuration
#
#  Copy to .env.local (development) or set in your hosting environment.
#  NEXT_PUBLIC_* values are inlined into the browser bundle at build time
#  and validated in src/lib/brand.ts: an invalid value fails the build.
#  Values shown are production examples for bitinvestcapital.com.
# ═════════════════════════════════════════════════════════════════════

# ── Server-side only (never sent to the browser) ─────────────────────
# Base URL of the NestJS API, used by the session and /api/backend relay
# routes. Use the private network address when both run in one cluster.
# Development: BACKEND_URL=http://localhost:3000
BACKEND_URL=https://api.bitinvestcapital.com

# ── Public (inlined into the browser bundle) ─────────────────────────
NEXT_PUBLIC_APP_NAME=BitInvest Capital
# Canonical site URL: metadata, Open Graph and footer links.
NEXT_PUBLIC_SITE_URL=https://bitinvestcapital.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@bitinvestcapital.com

# Block explorers for transaction links (mainnet).
# Testnets: https://sepolia.etherscan.io/tx and https://mempool.space/testnet/tx
NEXT_PUBLIC_ETH_EXPLORER_TX=https://etherscan.io/tx
NEXT_PUBLIC_BTC_EXPLORER_TX=https://mempool.space/tx
