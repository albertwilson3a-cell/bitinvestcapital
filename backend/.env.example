# ═════════════════════════════════════════════════════════════════════
#  BitInvest Capital API: environment configuration
#
#  Copy to .env and fill in the blanks. Every variable is validated at
#  startup (src/config/env.validation.ts); the API refuses to boot with
#  an invalid or unsafe value. Values shown are production examples for
#  bitinvestcapital.com unless marked "development".
# ═════════════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=production                      # development | production | test
PORT=3000
APP_NAME=BitInvest Capital               # shown in emails and logs

# ── Domain & CORS ────────────────────────────────────────────────────
# Browsers on https://bitinvestcapital.com and https://*.bitinvestcapital.com
# may call the API directly. Requests without an Origin (the Next.js server,
# webhooks) are unaffected.
CORS_ROOT_DOMAIN=bitinvestcapital.com
# Extra exact origins, comma-separated. Must be https in production.
# Development: CORS_EXTRA_ORIGINS=http://localhost:5173
CORS_EXTRA_ORIGINS=

# ── Database & cache ─────────────────────────────────────────────────
DATABASE_URL=postgresql://bitinvest:CHANGE_ME@db.internal.bitinvestcapital.com:5432/bitinvest?schema=public&sslmode=require
REDIS_CLUSTER_NODES=redis-1.internal.bitinvestcapital.com:6379,redis-2.internal.bitinvestcapital.com:6379,redis-3.internal.bitinvestcapital.com:6379
REDIS_PASSWORD=
# Only when the API runs outside the cluster's network (see README). Usually empty.
REDIS_NAT_MAP=
REDIS_KEY_PREFIX=bitinvest:

# ── Authentication ───────────────────────────────────────────────────
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# Token claims; tokens with any other issuer or audience are rejected.
JWT_ISSUER=https://bitinvestcapital.com
JWT_AUDIENCE=https://bitinvestcapital.com
BCRYPT_ROUNDS=12
VERIFICATION_TOKEN_TTL_MINUTES=1440
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Where the emailed /verify?token=… link points. Development: http://localhost:5173
FRONTEND_URL=https://bitinvestcapital.com

# ── Transactional email ──────────────────────────────────────────────
MAIL_PROVIDER=sendgrid                   # sendgrid | ses | smtp | log (log is refused in production)
MAIL_FROM_ADDRESS=no-reply@bitinvestcapital.com
MAIL_FROM_NAME=BitInvest Capital
MAIL_SUPPORT_ADDRESS=support@bitinvestcapital.com
MAIL_WEBSITE_URL=https://bitinvestcapital.com
# Registered company address for email footers; leave empty to omit the line.
MAIL_POSTAL_ADDRESS=
SENDGRID_API_KEY=                        # required when MAIL_PROVIDER=sendgrid
AWS_REGION=                              # required when MAIL_PROVIDER=ses (credentials via the AWS chain)
SES_CONFIGURATION_SET=

# SMTP (MAIL_PROVIDER=smtp): any mailbox or relay — Google Workspace/Gmail,
# Microsoft 365, Zoho, Brevo, Mailgun, Postmark, SES SMTP...
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the gmail address>,
#          SMTP_PASSWORD=<16-character App Password, not the normal password>,
#          MAIL_FROM_ADDRESS must be that same gmail address.
SMTP_HOST=
SMTP_PORT=587                            # 587 = STARTTLS (most providers), 465 = TLS
SMTP_SECURE=false                        # true only for port 465
SMTP_USER=
SMTP_PASSWORD=

# ── HD wallets: account-level EXTENDED PUBLIC keys only ──────────────
# Export from your custody / hardware wallet. Never put an xprv here: the API
# refuses private keys, and refuses the public BIP test keys in production.
ETH_ACCOUNT_XPUB=
ETH_ACCOUNT_PATH=m/44'/60'/0'
BTC_ACCOUNT_XPUB=
BTC_ACCOUNT_PATH=m/84'/0'/0'
BTC_NETWORK=mainnet                      # mainnet | testnet
USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# ── Payment webhooks (https://api.bitinvestcapital.com/payments/webhook) ─
# Comma-separated, current secret first; each 32+ chars. openssl rand -hex 32
WEBHOOK_SIGNING_SECRETS=
WEBHOOK_TOLERANCE_SECONDS=300
MIN_CONFIRMATIONS_BTC=3
MIN_CONFIRMATIONS_ETH=12
MIN_CONFIRMATIONS_USDT=12

# ── Prices & referral defaults ───────────────────────────────────────
PRICE_PROVIDER=coingecko                 # coingecko | simulated (development only; refused in production)
PRICE_API_URL=https://api.coingecko.com/api/v3
PRICE_API_KEY=
PRICE_CACHE_SECONDS=60
# Defaults until an admin sets them in the console (Parameters page).
REFERRAL_REWARD_RATE=0.01
AFFILIATE_YIELD_REWARD_RATE=0.05

# ── Yield engine ─────────────────────────────────────────────────────
YIELD_SCHEDULER_ENABLED=true
YIELD_BATCH_SIZE=500
YIELD_MAX_APY_PERCENT=100
YIELD_STALE_RUN_MINUTES=60

# ── Tests ──────────────────────────────────────────────────────────────────────
# Database used by `npm run test:platform`. It is dropped and rebuilt from
# prisma/migrations on every run, so the name must contain "test" and it must
# never point at real data.
TEST_DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/app_test?schema=public
